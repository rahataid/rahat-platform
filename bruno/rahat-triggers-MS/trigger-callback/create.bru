    "type":"ACTIVITY_COMMUNICATION",
    "config":{
        "activityUuid":"7bfd02be-ef28-49b1-a18b-0aa6c5a7fda3"
      }
    }
  }
}

settings {
  encodeUrl: true
  timeout: 0
  forwardAuthorizationHeader: false
}
