meta {
  name: sync-with-projects
  type: http
  seq: 14
}

post {
  url: {{url}}/beneficiaries/groups/{{ben_group_uuid}}/sync
  body: json
  auth: bearer
}

auth:bearer {
  token: eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..RhBlBDHd5113XpJ6HSiOxBdOppRFrSWjyOObazKj0S8
}

assert {
  res.status: eq 201
  res.body.success: eq true
  res.body.data: isJson
}

tests {
  test('should create new beneficiary if wallet is provided', async () => {
    const data = res.getBody();
    expect(res.getStatus()).to.equal(201);
    expect(res.body.success).to.equal(true);
    expect(res.body.data).to.equal(data.data);
  });
}
