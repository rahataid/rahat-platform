meta {
  name: upload-beneficiaries
  type: http
  seq: 15
}

post {
  url: {{url}}/beneficiaries/upload
  body: multipartForm
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

body:multipart-form {
  file: @file()
  doctype: XLSX
  projectId:
  groupName:
  groupPurpose:
}

assert {
  res.status: eq 201
  res.body.success: eq true
}

tests {
  test('should upload and import beneficiaries from file', async () => {
    const data = res.getBody();
    expect(res.body.success).to.equal(true);
    expect(res.body.data).to.be.an('object');
  });
}
